# ═══════════════════════════════════════════════════════════════
# AutoOps — Plantilla centralizada de variables de entorno
# Uso: cp .env.example .env  (nunca commitear .env)
# Regla: toda variable nueva se añade aquí en la misma US que la introduce.
# ═══════════════════════════════════════════════════════════════

# ── Servidor & Gateway ─────────────────────────────────────────
# Consumido por: apps/api_gateway
# Arranque local: python -m apps.api_gateway.run
# HOST: interfaz de escucha (127.0.0.1 en desarrollo; 0.0.0.0 en contenedor)
HOST=127.0.0.1
PORT=8000
# CORS_ALLOWED_ORIGINS: orígenes permitidos separados por comas.
# Vacío = ningún origen permitido (nunca se usa *).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=cambia_esta_clave

# WS_BROADCAST_TIMEOUT_SECONDS: tiempo máximo (s) para emitir un evento de IA por
# WebSocket; evita que un cliente lento retenga la tarea en segundo plano.
WS_BROADCAST_TIMEOUT_SECONDS=2

# PYTHONPATH: requerido para arrancar el Gateway desde la raíz del monorepo.
# Debe incluir la raíz del repo (módulo `apps`) y `services/ai-engine` (módulo
# `ai_engine`, que el Gateway importa para cargar el grafo). Ej. en desarrollo:
#   export PYTHONPATH=.:services/ai-engine
# En contenedor se fija con ENV en el Dockerfile / `environment:` de compose.
PYTHONPATH=.:services/ai-engine

# ── Base de Datos PostgreSQL ───────────────────────────────────
# Consumido por: apps/api_gateway, services/mcp-servers (servidor MCP de BD)
# El motor de IA NO usa estas variables: accede a la BD solo vía MCP.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoops_db
DB_USER=autoops_user
DB_PASSWORD=cambia_esta_clave
# Cadena de conexión asíncrona (SQLAlchemy + asyncpg). Consumido por: apps/api_gateway
# y Alembic (migraciones). Debe usar el driver `postgresql+asyncpg`.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# ── Modelos de IA & Telemetría ─────────────────────────────────
# Consumido por: services/ai-engine
# AI_MODEL_NAME: identificador del modelo de chat (obligatorio para el grafo)
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=tu_clave_openai
DEEPSEEK_API_KEY=tu_clave_deepseek
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=tu_clave_langsmith

# ── Servidores MCP ─────────────────────────────────────────────
# Transporte: HTTP con SSE (el estándar MCP para servidores remotos).
# Las *_SERVER_URL las consumen los clientes MCP (services/ai-engine) e incluyen el
# endpoint SSE `/sse`. En Compose el host será el nombre del servicio, p. ej.
# http://mcp-logs:5001/sse (red privada, sin publicar al host).
MCP_LOGS_SERVER_URL=http://localhost:5001/sse
MCP_DB_SERVER_URL=http://localhost:5002/sse
# Configuración de escucha del servidor de logs (services/mcp-servers/logs_server):
# MCP_LOGS_HOST: 127.0.0.1 en desarrollo; 0.0.0.0 en contenedor (lo fija el Dockerfile).
# MCP_LOGS_PORT: obligatorio; debe coincidir con el puerto de MCP_LOGS_SERVER_URL.
# Arranque local: MCP_LOGS_PORT=5001 python services/mcp-servers/logs_server/server.py
MCP_LOGS_HOST=127.0.0.1
MCP_LOGS_PORT=5001

# ── Frontend (Vite) ────────────────────────────────────────────
# Consumido por: apps/frontend (expuestas al navegador: nunca poner secretos)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
# Puerto del servidor de desarrollo de Vite (opcional; vacío = por defecto de Vite)
# Debe coincidir con un origen incluido en CORS_ALLOWED_ORIGINS del Gateway.
VITE_DEV_SERVER_PORT=5173
#
# En contenedor, Vite incrusta las VITE_* durante `docker build` (no en runtime):
# se pasan como --build-arg y cambiarlas exige reconstruir la imagen. Son públicas.
#   docker build -t autoops-frontend \
#     --build-arg VITE_API_BASE_URL=$VITE_API_BASE_URL \
#     --build-arg VITE_WS_BASE_URL=$VITE_WS_BASE_URL \
#     apps/frontend
# El contenedor escucha en el puerto 8080 (Nginx sin privilegios). Para servirlo en
# http://localhost:3000 se publica con `-p 3000:8080`; ese origen está en
# CORS_ALLOWED_ORIGINS.
