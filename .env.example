# ═══════════════════════════════════════════════════════════════
# AutoOps — Plantilla centralizada de variables de entorno
# Uso: cp .env.example .env  (nunca commitear .env)
# Regla: toda variable nueva se añade aquí en la misma US que la introduce.
# ═══════════════════════════════════════════════════════════════

# ── Servidor & Gateway ─────────────────────────────────────────
# Consumido por: apps/api_gateway
# Arranque local: python -m apps.api_gateway.run
# HOST: interfaz de escucha (127.0.0.1 en desarrollo; 0.0.0.0 en contenedor)
HOST=127.0.0.1
PORT=8000
# CORS_ALLOWED_ORIGINS: orígenes permitidos separados por comas.
# Vacío = ningún origen permitido (nunca se usa *).
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=cambia_esta_clave

# ── Base de Datos PostgreSQL ───────────────────────────────────
# Consumido por: apps/api_gateway, services/mcp-servers (servidor MCP de BD)
# El motor de IA NO usa estas variables: accede a la BD solo vía MCP.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoops_db
DB_USER=autoops_user
DB_PASSWORD=cambia_esta_clave

# ── Modelos de IA & Telemetría ─────────────────────────────────
# Consumido por: services/ai-engine
# AI_MODEL_NAME: identificador del modelo de chat (obligatorio para el grafo)
AI_MODEL_NAME=claude-sonnet-5-5
OPENAI_API_KEY=tu_clave_openai
ANTHROPIC_API_KEY=tu_clave_anthropic
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=tu_clave_langsmith

# ── Servidores MCP ─────────────────────────────────────────────
# Consumido por: services/ai-engine (clientes MCP)
MCP_LOGS_SERVER_URL=http://localhost:5001
MCP_DB_SERVER_URL=http://localhost:5002

# ── Frontend (Vite) ────────────────────────────────────────────
# Consumido por: apps/frontend (expuestas al navegador: nunca poner secretos)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
