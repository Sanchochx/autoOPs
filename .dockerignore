# Build context = monorepo root. Excludes secrets, local artifacts and
# everything no image needs.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Version control and working context
.git/
.gitignore
.claude/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Tests
tests/
pytest.ini

# Node / Frontend
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
*.tsbuildinfo

# Docker, logs and IDE
Dockerfile*
**/Dockerfile*
docker-compose*.yml
*.log
.idea/
.vscode/
.DS_Store
